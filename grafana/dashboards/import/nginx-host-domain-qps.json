          "refId": "QPS",
          "editorMode": "code",
          "queryType": "instant",
          "expr": "sum by (node, host) (rate({job=\"nginx\", node=~\"$node\"} | json | host != \"\" and host != \"-\" [5m]))",
          "legendFormat": "{{node}} / {{host}}"
