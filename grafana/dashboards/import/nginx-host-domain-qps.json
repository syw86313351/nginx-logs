{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "选择已配置的 Loki 数据源",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "12.2.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    }
  ],
  "uid": "nginx-host-domain-qps",
  "title": "Nginx 按主机查域名与QPS",
  "tags": ["nginx", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 22,
  "refresh": false,
  "time": { "from": "now-15m", "to": "now" },
  "links": [
    {
      "title": "最近访问明细",
      "type": "link",
      "url": "/d/nginx-access-recent?orgId=${__org.id}&from=${__from}&to=${__to}&${node:queryparam}",
      "targetBlank": true
    }
  ],
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "中转主机",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": { "type": "label_values", "label": "node", "stream": "{job=\"nginx\"}" },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1,
        "description": "选一台或多台中转；All 表示全部"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "各域名访问汇总（QPS / 流量 / 方法 / 静态 / 状态码 / 耗时）",
      "description": "总请求数=所选时间段内全部请求；近N秒=仪表板结束时刻向前 N 秒内的请求数（instant 查询）。入口域名、中转主机左侧冻结（Grafana ≥12.2）。",
      "gridPos": { "h": 18, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "showHeader": true,
        "frozenColumns": { "left": 2 },
        "sortBy": [{ "displayName": "每秒请求数", "desc": true }],
        "footer": {
          "show": true,
          "reducer": ["sum"],
          "fields": ["总请求数", "近1秒", "近2秒", "近3秒", "近5秒", "近10秒", "近15秒", "近30秒", "近60秒", "入口流量", "出口流量", "GET访问次数", "POST访问次数", "JS访问次数", "CSS访问次数", "状态码200", "状态码3xx", "状态码4xx", "状态码404", "状态码5xx", "耗时≤1秒", "耗时1~3秒", "耗时3~10秒", "耗时10~30秒", "耗时>30秒", "附件访问次数", "开放平台访问次数"]
        }
      },
      "fieldConfig": {
        "defaults": {
          "noValue": "0",
          "mappings": [
            {
              "type": "special",
              "options": {
                "null": { "index": 0, "text": "0" }
              }
            }
          ]
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "host" },
            "properties": [
              { "id": "displayName", "value": "入口域名" },
