{
  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "选择已配置的 Loki 数据源",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "12.2.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    }
  ],
  "uid": "nginx-ecterpapi-analytics",
  "title": "Nginx 开放平台 echterpapi 分析",
  "tags": [
    "nginx",
    "loki",
    "ecterpapi"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 10,
  "refresh": false,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "中转节点",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "query": {
          "label": "node",
          "stream": "{job=\"nginx\"}",
          "type": 1
        },
        "multi": false,
        "includeAll": false,
        "refresh": 2,
        "sort": 1,
        "description": "必选：先选中转节点，入口域名列表依赖此变量"
      },
      {
        "name": "host",
        "label": "入口域名",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "query": {
          "label": "server_name",
          "stream": "{job=\"nginx\",node=~\"$node\"}",
          "type": 1
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2,
        "sort": 1,
        "description": "Loki 标签 server_name（与 nginx-analytics 一致）；须先选中转节点"
      },
      {
        "name": "method",
        "label": "HTTP 方法",
        "type": "query",
        "datasource": {
          "type": "loki",
          "uid": "${DS_LOKI}"
        },
        "query": {
          "label": "request_method",
          "stream": "{job=\"nginx\",node=~\"$node\"}",
          "type": 1
        },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": {
          "text": "All",
          "value": "$__all"
        },
        "refresh": 2
      },
      {
        "name": "api_method",
        "label": "接口方法",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "description": "匹配 args/request_uri 中 method= 值，如 getProductInfo"
      },
      {
        "name": "api_key",
        "label": "AppKey",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        },
        "description": "匹配 args 中 apiKey= 值"
      },
      {
        "name": "client_ip",
        "label": "客户端 IP",
        "type": "textbox",
        "query": ".*",
        "current": {
          "text": ".*",
          "value": ".*"
        }
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "echterpapi 接口汇总（全字段）",
      "description": "按中转节点、域名、客户端 IP、AppKey、服务端 IP、HTTP 方法、接口 method 聚合。点击「总请求数」或「接口方法」跳转 Explore 查看明细。时间范围建议 ≤30m；Top 100。",
      "gridPos": {
        "h": 18,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "loki",
        "uid": "${DS_LOKI}"
