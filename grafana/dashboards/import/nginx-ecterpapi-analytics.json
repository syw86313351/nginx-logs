      "targets": [
        {
          "refId": "CNT",
          "editorMode": "code",
          "queryType": "instant",
          "expr": "sum by (node, server_name, client_ip, api_key, server_addr, request_method, api_method) (count_over_time({job=\"nginx\", node=~\"$node\", server_name=~\"$host\", request_method=~\"$method\"} | json | uri=~\".*ecterpapi.*\" | client_ip != \"\" and client_ip != \"-\" | server_addr != \"\" and server_addr != \"-\" | line_format \"{{.args}}&{{.request_uri}}\" | regexp `(?i)(?:^|[?&])method=(?P<api_method>[A-Za-z0-9_]+)` | regexp `(?i)(?:^|[?&])apiKey=(?P<api_key>[^&\"\\s]+)` | api_method != \"\" | api_method=~\"$api_method\" | api_key=~\"$api_key\" | client_ip=~\"$client_ip\" [$__range]))",
          "legendFormat": "{{api_method}}"
        },
        {
          "refId": "AVGRT",
          "editorMode": "code",
          "queryType": "instant",
          "expr": "avg by (node, server_name, client_ip, api_key, server_addr, request_method, api_method) (avg_over_time({job=\"nginx\", node=~\"$node\", server_name=~\"$host\", request_method=~\"$method\"} | json | uri=~\".*ecterpapi.*\" | client_ip != \"\" and client_ip != \"-\" | server_addr != \"\" and server_addr != \"-\" | line_format \"{{.args}}&{{.request_uri}}\" | regexp `(?i)(?:^|[?&])method=(?P<api_method>[A-Za-z0-9_]+)` | regexp `(?i)(?:^|[?&])apiKey=(?P<api_key>[^&\"\\s]+)` | api_method != \"\" | api_method=~\"$api_method\" | api_key=~\"$api_key\" | client_ip=~\"$client_ip\" | unwrap request_time [$__range]))",
