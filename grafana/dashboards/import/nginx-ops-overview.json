{  "__inputs": [
    {
      "name": "DS_LOKI",
      "label": "Loki",
      "description": "选择已配置的 Loki 数据源",
      "type": "datasource",
      "pluginId": "loki",
      "pluginName": "Loki"
    }
  ],
  "__requires": [
    {
      "type": "grafana",
      "id": "grafana",
      "name": "Grafana",
      "version": "10.0.0"
    },
    {
      "type": "datasource",
      "id": "loki",
      "name": "Loki",
      "version": "1.0.0"
    }
  ],
  "uid": "nginx-ops-overview",
  "title": "Nginx 运营总览",
  "tags": ["nginx", "loki"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "1m",
  "time": { "from": "now-15m", "to": "now" },
  "links": [
    {
      "title": "节点-域名统计",
      "type": "link",
      "url": "/d/nginx-node-domains?orgId=${__org.id}&from=${__from}&to=${__to}",
      "targetBlank": false
    },
    {
      "title": "故障排查",
      "type": "link",
      "url": "/d/nginx-troubleshoot?orgId=${__org.id}&from=${__from}&to=${__to}",
      "targetBlank": false
    }
  ],
  "templating": {
    "list": [
      {
        "name": "node",
        "label": "中转节点",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": { "type": "label_values", "label": "node", "stream": "{job=\"nginx\"}" },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1
      },
      {
        "name": "host",
        "label": "入口域名",
        "type": "query",
        "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
        "query": { "type": "label_values", "label": "host", "stream": "{job=\"nginx\",node=~\"$node\"}" },
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "refresh": 2,
        "sort": 1
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "type": "table",
      "title": "node × 域名 运营指标",
      "description": "指标合并在一张表。出口带宽与平均延迟含 unwrap，建议时间范围 ≤1h。",
      "gridPos": { "h": 14, "w": 24, "x": 0, "y": 0 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "options": {
        "showHeader": true,
        "sortBy": [{ "displayName": "QPS", "desc": true }]
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          { "matcher": { "id": "byName", "options": "QPS" }, "properties": [{ "id": "unit", "value": "reqps" }, { "id": "decimals", "value": 2 }] },
          { "matcher": { "id": "byName", "options": "出口KB/s" }, "properties": [{ "id": "unit", "value": "KBs" }, { "id": "decimals", "value": 1 }] },
          { "matcher": { "id": "byName", "options": "平均延迟(s)" }, "properties": [{ "id": "unit", "value": "s" }, { "id": "decimals", "value": 3 }] }
        ]
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (node, host) (rate({job=\"nginx\", node=~\"$node\", host=~\"$host\"}[5m]))",
          "instant": true
        },
        {
          "refId": "B",
          "expr": "sum by (node, host) (rate({job=\"nginx\", node=~\"$node\", host=~\"$host\", status_class=\"4xx\"}[5m]))",
          "instant": true
        },
        {
          "refId": "C",
          "expr": "sum by (node, host) (rate({job=\"nginx\", node=~\"$node\", host=~\"$host\", status_class=\"5xx\"}[5m]))",
          "instant": true
        },
        {
          "refId": "D",
          "expr": "sum by (node, host) (rate({job=\"nginx\", node=~\"$node\", host=~\"$host\"} | json | unwrap bytes_sent [5m])) / 1024",
          "instant": true
        },
        {
          "refId": "E",
          "expr": "sum by (node, host) (rate({job=\"nginx\", node=~\"$node\", host=~\"$host\"} | json | unwrap request_time [5m])) / sum by (node, host) (rate({job=\"nginx\", node=~\"$node\", host=~\"$host\"}[5m]))",
          "instant": true
        }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        {
          "id": "organize",
          "options": {
            "renameByName": {
              "node": "中转节点",
              "host": "入口域名",
              "Value #A": "QPS",
              "Value #B": "4xx/s",
              "Value #C": "5xx/s",
              "Value #D": "出口KB/s",
              "Value #E": "平均延迟(s)"
            },
            "excludeByName": { "Time": true }
          }
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "状态码类 QPS 趋势",
      "description": "观察 4xx/5xx 突增与流量异常。",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 14 },
      "datasource": { "type": "loki", "uid": "${DS_LOKI}" },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": { "lineWidth": 2, "fillOpacity": 8 }
        },
        "overrides": [
          { "matcher": { "id": "byName", "options": "4xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }] },
          { "matcher": { "id": "byName", "options": "5xx" }, "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }] }
        ]
      },
      "options": {
        "legend": { "displayMode": "table", "placement": "bottom", "calcs": ["mean", "max"] },
        "tooltip": { "mode": "multi" }
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (status_class) (rate({job=\"nginx\", node=~\"$node\", host=~\"$host\", status_class=~\"2xx|3xx|4xx|5xx\"}[5m]))",
          "legendFormat": "{{status_class}}"
        }
      ]
    }
  ]
}

